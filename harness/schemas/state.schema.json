{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xos.dev/schemas/state.schema.json",
  "title": "0xos project state.json",
  "description": "The machine resume anchor and Mission Control's primary feed. PURE DATA, ZERO PROSE. Validated on every write by the Stop hook. additionalProperties:false everywhere is deliberate — it rejects the ad-hoc scratch keys and prose blobs that rotted the reference harnesses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "mode", "phase", "subsystems", "gates", "decisions", "resume_pointer"],
  "properties": {
    "version": { "const": 3 },
    "updated_at": { "type": "string", "format": "date-time" },
    "mode": {
      "enum": ["incubating", "graduated"],
      "description": "incubating = zero/trial users, no real money (default, no gates). graduated = real users + real money (eject from harness / guarded mode)."
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name"],
      "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
    },
    "active_task": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "status"],
          "properties": {
            "id": { "type": "string" },
            "prefix": { "type": "string" },
            "status": { "enum": ["drafting", "approved", "in_progress", "in_review", "merged", "blocked"] },
            "blockers": { "type": "array", "items": { "type": "string" }, "description": "refs only (Q-IDs / DF-IDs), never prose" }
          }
        }
      ]
    },
    "in_flight_agents": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "description": "roster role, e.g. implementer, auditor" },
          "backend": { "enum": ["claude", "omp", "gemini", "codex", "other"] },
          "model": { "type": "string" },
          "spec": { "type": "string" },
          "worktree": { "type": "string" },
          "started_at": { "type": "string", "format": "date-time" },
          "tokens": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "subsystems": {
      "type": "object",
      "description": "map: prefix -> status. chi's map form (the good one).",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "enum": ["planned", "active", "merged", "blocked", "deferred"] },
          "note": { "type": "string", "maxLength": 140, "description": "one terse line, not a paragraph" }
        }
      }
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "specs"],
        "properties": {
          "id": { "type": "integer" },
          "specs": { "type": "array", "items": { "type": "string" } },
          "outcome": { "enum": ["in_progress", "merged", "reverted", "partial"] }
        }
      }
    },
    "gates": {
      "type": "object",
      "description": "map: gate name -> verdict. structured, NOT prose.",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": { "enum": ["green", "yellow", "red", "unknown"] },
          "at": { "type": "string", "format": "date-time" },
          "evidence_ref": { "type": "string", "description": "path to the audit doc, not the evidence text" }
        }
      }
    },
    "drift_flags": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "severity", "summary"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["low", "medium", "high"] },
          "tag": { "type": "string" },
          "summary": { "type": "string", "maxLength": 200 },
          "ref": { "type": "string" }
        }
      }
    },
    "decisions": {
      "type": "object", "additionalProperties": false,
      "required": ["open", "ref"],
      "properties": {
        "open": { "type": "integer", "minimum": 0, "description": "count of OPEN records in decisions.json" },
        "max_severity": { "enum": ["none", "low", "normal", "high", "critical"] },
        "needs_input": { "type": "integer", "minimum": 0, "description": "count of records that actually pause an agent" },
        "ref": { "type": "string" }
      }
    },
    "resume_pointer": {
      "type": "object", "additionalProperties": false,
      "description": "replaces the 900-word resume_hint. four fields, not an essay.",
      "required": ["read"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "string" },
        "next_pull_hint": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
